{
  "name": "@jondotsoy/configs",
  "version": "1.2.9",
  "description": "A reactive, typed configuration library backed by pluggable sources (env, fetch, sse, file, literal).",
  "keywords": [
    "config",
    "configuration",
    "env",
    "environment-variables",
    "reactive",
    "typescript",
    "source",
    "sse",
    "fetch",
    "file",
    "json",
    "dotenv"
  ],
  "module": "src/configs.ts",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@jon.soy",
    "url": "https://jon.soy"
  },
  "homepage": "https://github.com/JonDotsoy/configs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/configs.git"
  },
  "bugs": {
    "url": "https://github.com/JonDotsoy/configs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "_entryPoint": "./src/configs.ts",
      "types": "./dist/configs.d.ts",
      "import": "./dist/configs.js"
    },
    "./sources/env": {
      "_entryPoint": "./src/sources/env.ts",
      "types": "./dist/sources/env.d.ts",
      "import": "./dist/sources/env.js"
    },
    "./sources/fetch": {
      "_entryPoint": "./src/sources/fetch.ts",
      "types": "./dist/sources/fetch.d.ts",
      "import": "./dist/sources/fetch.js"
    },
    "./sources/sse": {
      "_entryPoint": "./src/sources/sse.ts",
      "types": "./dist/sources/sse.d.ts",
      "import": "./dist/sources/sse.js"
    },
    "./sources/file": {
      "_entryPoint": "./src/sources/file.ts",
      "types": "./dist/sources/file.d.ts",
      "import": "./dist/sources/file.js"
    },
    "./sources/literal": {
      "_entryPoint": "./src/sources/literal.ts",
      "types": "./dist/sources/literal.d.ts",
      "import": "./dist/sources/literal.js"
    },
    "./sources/pull": {
      "_entryPoint": "./src/sources/pull.ts",
      "types": "./dist/sources/pull.d.ts",
      "import": "./dist/sources/pull.js"
    },
    "./sources/shell": {
      "_entryPoint": "./src/sources/shell.ts",
      "types": "./dist/sources/shell.d.ts",
      "import": "./dist/sources/shell.js"
    },
    "./react": {
      "_entryPoint": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./node": {
      "_entryPoint": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./utils/metrics": {
      "_entryPoint": "./src/utils/metric.ts",
      "types": "./dist/utils/metric.d.ts",
      "import": "./dist/utils/metric.js"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:types": "tsc -p tsconfig.build.json",
    "test:browser": "playwright test",
    "test:cases": "bun run scripts/run-test-cases.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "^19",
    "react": "^19",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19",
    "typescript": "^5",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
