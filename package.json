{
  "name": "hotconfigs",
  "version": "1.0.9",
  "description": "A reactive, typed configuration library backed by pluggable sources (env, fetch, sse, file, literal).",
  "keywords": [
    "config",
    "configuration",
    "env",
    "environment-variables",
    "reactive",
    "typescript",
    "source",
    "sse",
    "fetch",
    "file",
    "json",
    "dotenv"
  ],
  "module": "src/configs.ts",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@jon.soy",
    "url": "https://jon.soy"
  },
  "homepage": "https://github.com/JonDotsoy/configs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/configs.git"
  },
  "bugs": {
    "url": "https://github.com/JonDotsoy/configs/issues"
  },
  "_buildEntripoint": {
    ".": "./src/configs.ts",
    "./sources/env": "./src/sources/env.ts",
    "./sources/fetch": "./src/sources/fetch.ts",
    "./sources/sse": "./src/sources/sse.ts",
    "./sources/file": "./src/sources/file.ts",
    "./sources/literal": "./src/sources/literal.ts",
    "./sources/pull": "./src/sources/pull.ts",
    "./sources/shell": "./src/sources/shell.ts",
    "./react": "./src/react.ts",
    "./node": "./src/node.ts",
    "./utils/metrics": "./src/utils/metric.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:tsc": "tsc -p tsconfig.build.json",
    "test:browser": "playwright test",
    "test:cases": "bun run scripts/run-test-cases.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "^19",
    "react": "^19",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19",
    "typescript": "^5",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
